# Copy to .env. Never commit .env.
ANTHROPIC_API_KEY=                 # from https://console.anthropic.com/ (needed for photo reading, AI screening, chatbot)
DATA_ENCRYPTION_KEY=               # created automatically on first run
SESSION_SECRET=                    # optional; set it so sign-ins survive restarts
HTTPS_ONLY=0                       # set to 1 when served over HTTPS
ESCALATION_WEBHOOK_URL=            # optional; receives risk alerts (e.g. a Twilio/SendGrid function)
ESCALATION_WEBHOOK_SECRET=         # optional; HMAC-SHA256 signature in X-CareBridge-Signature
FHIR_SERVER_URL=                   # optional; hospital FHIR R4 base URL (HTTPS)
FHIR_BEARER_TOKEN=                 # optional
VAPID_PRIVATE_KEY=                 # reminder notifications; created automatically on first run
VAPID_PUBLIC_KEY=                  # created automatically on first run
VAPID_CONTACT=mailto:admin@example.com  # contact address sent to push services
